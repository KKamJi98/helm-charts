{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "githubAuth": {
      "type": "object",
      "required": [
        "enabled",
        "existingSourceReuseApproved"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSourceReuseApproved": {
          "type": "boolean"
        }
      }
    },
    "imagePullSecret": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
