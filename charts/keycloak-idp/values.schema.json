{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preparationProfile",
    "publicCaProjection",
    "keycloak",
    "database"
  ],
  "properties": {
    "publicCaProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "preparationProfile": {
      "enum": [
        "keycloak-26.8.2-local-only",
        "keycloak-26.8.2-production"
      ]
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances",
        "image",
        "startOptimized",
        "automountServiceAccountToken",
        "resources",
        "db",
        "truststores",
        "additionalOptions",
        "hostname",
        "http",
        "httpManagement",
        "proxy",
        "ingress",
        "networkPolicy",
        "bootstrapAdmin",
        "update",
        "scheduling",
        "import"
      ],
      "properties": {
        "instances": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "image": {
          "const": "quay.io/keycloak/keycloak@sha256:c68e286cacd87b942ac1939a0a1481461109d6acd3a57dc496969a319a76bbf0"
        },
        "startOptimized": {
          "const": false
        },
        "automountServiceAccountToken": {
          "const": false
        },
        "resources": {
          "type": "object"
        },
        "db": {
          "const": {
            "vendor": "postgres",
            "host": "keycloak-db-rw.keycloak.svc.cluster.local",
            "port": 5432,
            "database": "keycloak",
            "usernameSecret": {
              "name": "keycloak-db-app",
              "key": "username"
            },
            "passwordSecret": {
              "name": "keycloak-db-app",
              "key": "password"
            }
          }
        },
        "truststores": {
          "const": {
            "database": {
              "secret": {
                "name": "keycloak-db-client-trust",
                "optional": false
              }
            }
          }
        },
        "additionalOptions": {
          "const": [
            {
              "name": "db-tls-mode",
              "value": "verify-server"
            }
          ]
        },
        "hostname": {
          "const": {
            "hostname": "https://sso.kkamji.net",
            "strict": true
          }
        },
        "http": {
          "const": {
            "httpEnabled": true,
            "httpPort": 8080
          }
        },
        "httpManagement": {
          "const": {
            "port": 9000
          }
        },
        "proxy": {
          "const": {
            "headers": "xforwarded"
          }
        },
        "ingress": {
          "const": {
            "enabled": false
          }
        },
        "networkPolicy": {
          "const": {
            "enabled": false
          }
        },
        "bootstrapAdmin": {
          "const": {
            "user": {
              "secret": "keycloak-bootstrap-admin"
            }
          }
        },
        "update": {
          "const": {
            "strategy": "RecreateOnImageChange",
            "scheduling": {
              "affinity": {
                "nodeAffinity": {
                  "requiredDuringSchedulingIgnoredDuringExecution": {
                    "nodeSelectorTerms": [
                      {
                        "matchExpressions": [
                          {
                            "key": "kubernetes.io/hostname",
                            "operator": "In",
                            "values": [
                              "k8s-w1",
                              "k8s-w2"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              "tolerations": []
            }
          }
        },
        "scheduling": {
          "const": {
            "affinity": {
              "nodeAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": {
                  "nodeSelectorTerms": [
                    {
                      "matchExpressions": [
                        {
                          "key": "kubernetes.io/hostname",
                          "operator": "In",
                          "values": [
                            "k8s-w1",
                            "k8s-w2"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app": "keycloak",
                        "app.kubernetes.io/instance": "keycloak",
                        "app.kubernetes.io/managed-by": "keycloak-operator",
                        "app.kubernetes.io/component": "server"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            },
            "tolerations": []
          }
        },
        "import": {
          "const": {
            "scheduling": {
              "affinity": {
                "nodeAffinity": {
                  "requiredDuringSchedulingIgnoredDuringExecution": {
                    "nodeSelectorTerms": [
                      {
                        "matchExpressions": [
                          {
                            "key": "kubernetes.io/hostname",
                            "operator": "In",
                            "values": [
                              "k8s-w1",
                              "k8s-w2"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              "tolerations": []
            }
          }
        }
      }
    },
    "database": {
      "type": "object"
    },
    "productionPhase": {
      "enum": [
        "database",
        "application"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "preparationProfile": {
          "const": "keycloak-26.8.2-local-only"
        },
        "database": {
          "$ref": "#/definitions/preparationDatabase"
        },
        "keycloak": {
          "properties": {
            "instances": {
              "const": 2
            },
            "resources": {
              "const": {
                "requests": {
                  "cpu": "1",
                  "memory": "2Gi"
                },
                "limits": {
                  "cpu": "2",
                  "memory": "2Gi"
                }
              }
            }
          }
        }
      },
      "not": {
        "required": [
          "productionPhase"
        ]
      }
    },
    {
      "required": [
        "productionPhase"
      ],
      "properties": {
        "preparationProfile": {
          "const": "keycloak-26.8.2-production"
        },
        "publicCaProjection": {
          "const": {
            "enabled": true
          }
        },
        "database": {
          "$ref": "#/definitions/productionDatabase"
        },
        "keycloak": {
          "properties": {
            "instances": {
              "const": 1
            },
            "resources": {
              "const": {
                "requests": {
                  "cpu": "50m",
                  "memory": "768Mi"
                },
                "limits": {
                  "cpu": "1500m",
                  "memory": "1536Mi"
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "preparationDatabase": {
      "const": {
        "instances": 3,
        "imageName": "ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie@sha256:42708a75345b7a48fdd9257b071830783a97fd228529196b6313187a7198e185",
        "enableSuperuserAccess": false,
        "certificates": {
          "serverAltDNSNames": [
            "keycloak-db-rw.keycloak.svc.cluster.local"
          ]
        },
        "bootstrap": {
          "initdb": {
            "database": "keycloak",
            "owner": "keycloak",
            "secret": {
              "name": "keycloak-db-app"
            }
          }
        },
        "storage": {
          "size": "10Gi",
          "storageClass": "local-path"
        },
        "resources": {
          "requests": {
            "cpu": "250m",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "1",
            "memory": "1Gi"
          }
        },
        "affinity": {
          "enablePodAntiAffinity": true,
          "podAntiAffinityType": "preferred",
          "topologyKey": "kubernetes.io/hostname",
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "In",
                      "values": [
                        "k8s-w1",
                        "k8s-w2"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "tolerations": []
        }
      }
    },
    "productionDatabase": {
      "const": {
        "instances": 1,
        "imageName": "ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie@sha256:42708a75345b7a48fdd9257b071830783a97fd228529196b6313187a7198e185",
        "enableSuperuserAccess": false,
        "certificates": {
          "serverAltDNSNames": [
            "keycloak-db-rw.keycloak.svc.cluster.local"
          ]
        },
        "bootstrap": {
          "initdb": {
            "database": "keycloak",
            "owner": "keycloak",
            "secret": {
              "name": "keycloak-db-app"
            }
          }
        },
        "storage": {
          "size": "10Gi",
          "storageClass": "local-path"
        },
        "resources": {
          "requests": {
            "cpu": "25m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "512Mi"
          }
        },
        "affinity": {
          "enablePodAntiAffinity": true,
          "podAntiAffinityType": "preferred",
          "topologyKey": "kubernetes.io/hostname",
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "In",
                      "values": [
                        "k8s-w1",
                        "k8s-w2"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "tolerations": []
        },
        "backup": {
          "retentionPolicy": "30d",
          "barmanObjectStore": {
            "destinationPath": "s3://kkamji-keycloak-pg-backup/keycloak",
            "s3Credentials": {
              "accessKeyId": {
                "name": "keycloak-backup-s3",
                "key": "ACCESS_KEY_ID"
              },
              "secretAccessKey": {
                "name": "keycloak-backup-s3",
                "key": "ACCESS_SECRET_KEY"
              },
              "region": {
                "name": "keycloak-backup-s3",
                "key": "AWS_REGION"
              }
            },
            "data": {
              "compression": "gzip",
              "encryption": "AES256"
            },
            "wal": {
              "compression": "gzip",
              "encryption": "AES256"
            }
          }
        }
      }
    }
  }
}
